# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Recipes uploaded through the dashboard may contain real client credentials:
# only the shipped examples (and their sample files) are tracked.
recipes/*
!recipes/example_*.yaml
!recipes/assets/

# Runtime output
jobs/
logs/
# Schedules and saved data sheets/profiles (may hold personal data)
data/
.mypy_cache/
.ruff_cache/
.pytest_cache/
